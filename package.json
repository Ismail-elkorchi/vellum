{
  "name": "vellum-markdown-editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "snapshots": "npm run build && node dist/scripts/generate-snapshots.js",
    "verify": "npm test && npm run snapshots"
  },
  "dependencies": {
    "@ismail-elkorchi/terminal-ui": "0.1.3",
    "markspan": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.0"
  },
  "description": "A terminal-first Markdown editor with an incremental source-aware preview.",
  "engines": {
    "node": ">=24"
  }
}
